{
  "name": "anycicd",
  "version": "2.0.0",
  "private": false,
  "bin": "bin/www.ts",
  "scripts": {
    "start": "node ./bin/www.ts",
    "dev": " nodemon ",
    "clean": "rm -r -- dist built",
    "compile": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsc && node --test dist/test/*.test.js",
    "build": "yarn run compile && yarn run build:generic",
    "build:generic": "./build.sh  generic",
    "build:armv6": "./build.sh  rpi"
  },
  "pkg": {
    "scripts": "./*.js",
    "assets": [
      "logs/*",
      "exec/*"
    ],
    "targets": [
      "latest-x64-linux",
      "latest-x64-windows"
    ]
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "compression": "^1.7.4",
    "cookie-parser": "~1.4.4",
    "dotenv": "^16.4.4",
    "express": "~4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "morgan": "~1.10.0",
    "rotating-file-stream": "^3.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.6",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.19",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "nodemon": "^3.0.3",
    "pkg": "^5.8.1",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.73.0"
  }
}
